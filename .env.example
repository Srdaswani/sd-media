# Copy these into Vercel → Settings → Environment Variables.
# Nothing here is needed to deploy: the site builds and runs without them.

# --- Photos (Cloudinary). Dashboard → Programmable Media → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=sd-media

# --- Video (YouTube Data API v3). console.cloud.google.com → Credentials.
YOUTUBE_API_KEY=
YOUTUBE_PLAYLIST_ID=

# --- Optional. Lets you force a gallery live instantly instead of waiting
#     five minutes. Invent any long random string.
REVALIDATE_SECRET=

# --- Set this to your real domain once you have one.
NEXT_PUBLIC_SITE_URL=https://sd-media.vercel.app
